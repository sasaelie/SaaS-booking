{
  "design_system": {
    "name": "Crystal Ice Block & Liquid Meniscus UI",
    "version": "2.2",
    "aesthetic_reference": "Real Melting Ice Cube / Convex Water Meniscus / Apple Liquid Glass",
    "customizable_tokens": {
      "--ui-text-primary": "#143D2B",
      "--ice-tint-rgb": "245, 252, 255",
      "--ice-refraction-scale": "6",
      "--ice-meniscus-thickness": "3px"
    },
    "optical_layers": {
      "ice_cube_shell": {
        "border_radius_px": 34,
        "backdrop_filter": "blur(20px) saturate(210%) contrast(106%) brightness(105%)",
        "surface_gradient": "radial-gradient(120% 100% at 50% 0%, rgba(255,255,255,0.52) 0%, rgba(245,252,255,0.16) 48%, rgba(245,252,255,0.38) 100%)",
        "top_meniscus_highlight": "inset 0 3px 6px 0 rgba(255,255,255,0.95)",
        "bottom_internal_refraction": "inset 0 -8px 18px 0 rgba(255,255,255,0.55)",
        "caustic_drop_shadow": "0 24px 48px -12px rgba(10,35,25,0.16)"
      },
      "ice_slot_pebble": {
        "description": "Galet de glace poli pour chaque créneau horaire",
        "border_radius_px": 18,
        "selected_dome_shadow": "inset 0 3px 5px rgba(255,255,255,0.98), inset 0 -4px 8px rgba(255,255,255,0.7), 0 8px 18px rgba(20,61,43,0.10)"
      },
      "liquid_ice_button": {
        "shape": "Convex Water Droplet Capsule (border-radius: 9999px)",
        "wet_specular_crown": "Top inner arc (height 38%, linear-gradient white 92% to 0%)",
        "text_rendering": "Crisp flat typography (zero text-shadow, 100% sharpness)",
        "press_physics": "scale(0.972) translateY(1.5px) with cubic-bezier(0.22, 1, 0.36, 1)"
      }
    }
  }
}
