# PostgreSQL : choisir une région UE et activer TLS en production.
DATABASE_URL="postgresql://user:password@localhost:5432/booking"
# Supabase : schéma privé créé au préalable ; pooler SESSION port 5432, TLS verify-full.
# Ne pas utiliser le pooler transactionnel 6543 avec les verrous de facturation actuels.
# DATABASE_SCHEMA="booking"
# DATABASE_SSL_CA : certificat PEM public officiel Supabase, avec ses retours à la ligne.
# https://supabase.com/docs/guides/platform/ssl-enforcement
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Recette uniquement : bloquer tous les appels de paiement réels.
# APP_ENVIRONMENT="staging"
# PAYMENTS_ENABLED="false"
# Remplacer par une valeur aléatoire d'au moins 32 caractères. Aucun secret réel dans Git.
SELF_CANCEL_HMAC_SECRET="replace_with_a_random_secret_of_at_least_32_characters"

# Comptes organisateurs : clé indépendante, aléatoire, au moins 32 caractères.
# BETTER_AUTH_SECRET="replace_with_an_independent_random_secret_at_least_32_characters"

# Abonnement de la plateforme : prix Stripe récurrent 19,99 EUR / mois, quantité 1.
# STRIPE_SAAS_PRICE_ID="price_replace_me"
# STRIPE_SAAS_WEBHOOK_SECRET="whsec_replace_me_billing"

# Stripe Connect Standard OAuth : encaissement directement sur le compte de chaque organisateur.
# STRIPE_CONNECT_CLIENT_ID="ca_replace_me"
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_replace_me_connect"

# Stripe : nécessaires pour les activités STRIPE. Utiliser les clés de test avant mise en service.
# STRIPE_SECRET_KEY="sk_test_replace_me"
# STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Notifications (domaine d'expédition validé auprès de Resend).
# RESEND_API_KEY="re_replace_me"
# MAIL_FROM="reservations@example.com"

# Stockage S3 compatible privé, dans une région UE ; aucune ACL publique.
# STORAGE_ENDPOINT="https://your-private-storage-endpoint"
# STORAGE_REGION="eu-central-1"
# STORAGE_BUCKET="private-bank-proofs"
# STORAGE_ACCESS_KEY_ID="replace_me"
# STORAGE_SECRET_ACCESS_KEY="replace_me"

# Intégration API administrative optionnelle (la console web utilise les cookies Better Auth) : jetons OIDC RS256/ES256, rôle admin et organisation_id vérifiés.
# AUTH_ISSUER="https://identity.example.com/"
# AUTH_AUDIENCE="saas-booking"
# AUTH_JWKS_URL="https://identity.example.com/.well-known/jwks.json"

# Tâches planifiées : appeler POST /api/jobs avec Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET="replace_with_another_random_secret_of_at_least_32_characters"

# Tests d'intégration uniquement : base locale jetable nommée booking_test.
# TEST_DATABASE_URL="postgresql://postgres:booking_test_only@127.0.0.1:55432/booking_test"
