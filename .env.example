# --- Base de données PostgreSQL (région UE frankfurt/paris) ---
DATABASE_URL="postgresql://user:password@your-postgres-host.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# --- Paiements Stripe (Clés Live ou Test) ---
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Sécurité & Jeton HMAC d'annulation autonome (Min 16 caractères) ---
SELF_CANCEL_HMAC_SECRET="change_this_to_a_very_secure_random_secret_string_123456"

# --- URL de production du SaaS ---
NEXT_PUBLIC_APP_URL="https://studio-creatif-360.be"
