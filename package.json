{
  "name": "studio-creatif-360-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write src scripts tests",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "drizzle-orm": "0.45.4",
    "pg": "^8.16.3",
    "stripe": "^22.3.0",
    "zod": "4.6.7",
    "resend": "^6.5.2",
    "jose": "6.2.15",
    "sharp": "0.35.5",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "^5.9.3",
    "vitest": "5.1.0",
    "tsx": "^4.21.0",
    "prettier": "^3.6.2",
    "@playwright/test": "^1.58.0",
    "@next/eslint-plugin-next": "16.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.5"
  }
}
