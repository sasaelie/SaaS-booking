{
  "name": "studio-creatif-360-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=qa-results/unit.json",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write src scripts tests",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "check:deployment": "node --import tsx scripts/check-deployment.ts",
    "check:storage": "node --import tsx scripts/check-storage.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=default --reporter=json --outputFile=qa-results/integration.json",
    "test:e2e": "playwright test",
    "test:summary": "node --import tsx scripts/test-summary.ts",
    "check:security": "node --import tsx scripts/check-security-advisories.ts",
    "check:runtime-traces": "node --import tsx scripts/check-runtime-traces.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@better-auth/utils": "0.5.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "jose": "6.2.17",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.38.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.5",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
