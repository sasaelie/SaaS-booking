{
  "name": "studio-creatif-360-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=json --outputFile=qa-results/unit.json",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write src scripts tests",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "check:deployment": "node --import tsx scripts/check-deployment.ts",
    "check:storage": "node --import tsx scripts/check-storage.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=default --reporter=json --outputFile=qa-results/integration.json",
    "test:e2e": "playwright test",
    "test:summary": "node --import tsx scripts/test-summary.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/s3-request-presigner": "3.1164.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "jose": "6.2.15",
    "next": "16.4.5",
    "pg": "^8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.5.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "^22.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "10.14.0",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "overrides": {
    "minimatch": "11.0.5",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
